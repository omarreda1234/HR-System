@model IEnumerable<HRSystem.Models.FingerDevice>

@{
    ViewData["Title"] = "أجهزة البصمة";
}

<style>
    .page-header {
        margin-bottom: 2rem;
        padding: 1.5rem;
        background: white;
        border-radius: 15px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .premium-table-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        background: white;
        overflow: hidden;
    }

    .table thead th {
        background-color: #f8f9fc;
        color: #4e73df;
        font-weight: 700;
        text-transform: uppercase;
        border-top: none;
        padding: 1rem;
    }

    .table td {
        padding: 1rem;
        vertical-align: middle;
    }

    .device-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .device-avatar {
        width: 45px;
        height: 45px;
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 4px 10px rgba(78, 115, 223, 0.3);
    }

    .status-pill {
        padding: 5px 12px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .status-active { background: #e1f7ed; color: #1cc88a; }
    .status-inactive { background: #ffebeb; color: #e74a3b; }

    .action-btn-group {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

    .btn-circle-sm {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        transition: all 0.2s;
        border: none;
    }

    .btn-circle-sm:hover {
        transform: scale(1.1);
    }

    /* DataTables Overrides for RTL and Responsiveness */
    .dataTables_wrapper .dataTables_length, .dataTables_wrapper .dataTables_filter {
        margin-bottom: 1rem;
        padding: 0 1rem;
    }
    
    .dataTables_filter input {
        border-radius: 20px !important;
        padding: 5px 15px !important;
        border: 1px solid #d1d3e2 !important;
        outline: none;
    }

    /* Mobile Adaptations */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            text-align: center;
        }
        
        .action-btn-group {
            justify-content: center;
        }
    }
</style>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

<div class="animate__animated animate__fadeIn">
    <!-- Header Section -->
    <div class="page-header">
        <div>
            <h3 class="fw-bold text-dark mb-0"><i class="fas fa-microchip text-primary me-2"></i> إدارة الأجهزة</h3>
            <p class="text-muted small mb-0">تحكم وراقب جميع أجهزة البصمة في شبكتك</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("SuperAdmin") || User.IsInRole("HR"))
            {
                <button class="btn btn-success fw-bold rounded-pill px-3 shadow-sm" onclick="openExcelImportModal(null)">
                    <i class="fas fa-file-excel me-1"></i> استيراد موظفين من Excel
                </button>
                <button class="btn btn-gradient rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
                    <i class="fas fa-plus me-1"></i> إضافة جهاز
                </button>
            }
            <a asp-action="ExportDevices" class="btn btn-outline-secondary border-2 fw-bold rounded-pill px-3">
                <i class="fas fa-download me-1"></i> تصدير الأجهزة
            </a>
        </div>
    </div>

    <!-- Main Table Card -->
    <div class="card premium-table-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="devicesTable">
                    <thead>
                        <tr>
                            <th>الجهاز</th>
                            <th>الفرع</th>
                            <th>العنوان الشبكي</th>
                            <th>الحالة</th>
                            <th>آخر تواصل</th>
                            <th class="text-center">التحكم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="device-info">
                                        <div class="device-avatar">
                                            <i class="fas fa-network-wired"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.DeviceName</div>
                                            <div class="text-muted smaller">S/N: @(item.SerialNumber ?? "---")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary fw-bold px-3 py-2 rounded-pill border">
                                        <i class="fas fa-building me-1"></i> @(item.Branch?.BranchName ?? "غير محدد")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <code class="text-primary fw-bold">@item.Ipaddress</code>
                                        <span class="text-muted small">:@(item.Port ?? 4370)</span>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("HR"))
                                        {
                                            <button class="btn btn-link p-0 text-warning ms-1" 
                                                    data-device-id="@item.DeviceId"
                                                    data-device-name="@item.DeviceName"
                                                    data-ipaddress="@item.Ipaddress"
                                                    data-port="@(item.Port ?? 4370)"
                                                    data-branch-id="@item.BranchId"
                                                    data-serial-number="@item.SerialNumber"
                                                    data-is-active="@item.IsActive"
                                                    data-last-sync-time="@(item.LastSyncTime?.ToString("o"))"
                                                    onclick="initEditDevice(this)" 
                                                    title="تعديل العنوان الشبكي">
                                                <i class="fas fa-edit fa-xs"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="status-pill @(item.IsActive == true ? "status-active" : "status-inactive")" id="status-@item.DeviceId">
                                        <i class="fas @(item.IsActive == true ? "fa-circle" : "fa-circle-xmark") small"></i>
                                        @(item.IsActive == true ? "نشط" : "متوقف")
                                    </span>
                                </td>
                                <td class="small">
                                    @if(item.LastSyncTime.HasValue) {
                                        <span class="text-dark">@item.LastSyncTime.Value.ToString("yyyy/MM/dd")</span><br/>
                                        <span class="text-muted smaller">@item.LastSyncTime.Value.ToString("hh:mm tt")</span>
                                    } else {
                                        <span class="text-muted italic">لم يسبق</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-btn-group justify-content-center">
                                        <button class="btn btn-circle-sm btn-outline-info" onclick="pingDevice(@item.DeviceId)" title="اختبار الاتصال">
                                            <i class="fas fa-satellite-dish"></i>
                                        </button>
                                        <button class="btn btn-circle-sm btn-outline-primary" onclick="checkPort(@item.DeviceId)" title="فحص البورت">
                                            <i class="fas fa-plug"></i>
                                        </button>
                                        <button class="btn btn-circle-sm btn-warning text-white" onclick="syncNow(@item.DeviceId, this)" title="سحب الحركات">
                                            <i class="fas fa-sync-alt"></i>
                                        </button>
                                        <button class="btn btn-circle-sm btn-outline-secondary" onclick="syncDeviceTime(@item.DeviceId, this)" title="ضبط وقت الجهاز">
                                            <i class="fas fa-clock"></i>
                                        </button>
                                        @if (User.IsInRole("SuperAdmin") || User.IsInRole("HR"))
                                        {
                                            <button class="btn btn-circle-sm btn-outline-warning" 
                                                    data-device-id="@item.DeviceId"
                                                    data-device-name="@item.DeviceName"
                                                    data-ipaddress="@item.Ipaddress"
                                                    data-port="@(item.Port ?? 4370)"
                                                    data-branch-id="@item.BranchId"
                                                    data-serial-number="@item.SerialNumber"
                                                    data-is-active="@item.IsActive"
                                                    data-last-sync-time="@(item.LastSyncTime?.ToString("o"))"
                                                    onclick="initEditDevice(this)" 
                                                    title="تعديل الجهاز">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-circle-sm btn-outline-success" onclick="openExcelImportModal(@item.DeviceId, '@item.DeviceName', '@item.Ipaddress')" title="استيراد موظفين من Excel لهذا الجهاز">
                                                <i class="fas fa-file-excel"></i>
                                            </button>
                                            <button class="btn btn-circle-sm btn-success" onclick="openAddUser(@item.DeviceId)" title="إضافة موظف فردي">
                                                <i class="fas fa-user-plus"></i>
                                            </button>
                                            <button class="btn btn-circle-sm btn-danger" onclick="deleteDevice(@item.DeviceId)" title="حذف الجهاز">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="mt-1 text-center" id="log-@item.DeviceId" style="min-height: 18px;"></div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <!-- Modal: Add Device (Updated with Premium Style) -->
    <div class="modal fade" id="addDeviceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header bg-primary text-white" style="border-radius: 20px 20px 0 0;">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i> إضافة جهاز بصمة جديد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateDevice" method="post">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم الجهاز</label>
                            <input name="DeviceName" class="form-control rounded-pill px-3" placeholder="مثال: بصمة الدور الثالث" required />
                        </div>
                        <div class="row">
                            <div class="col-md-7 mb-3">
                                <label class="form-label fw-bold">IP العنوان</label>
                                <input name="Ipaddress" class="form-control rounded-pill px-3" placeholder="192.168.1.100" required />
                            </div>
                            <div class="col-md-5 mb-3">
                                <label class="form-label fw-bold">البورت</label>
                                <input name="Port" type="number" class="form-control rounded-pill px-3" value="4370" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الفرع</label>
                            <select name="BranchId" class="form-select rounded-pill px-3" required>
                                <option value="">-- اختر الفرع --</option>
                                @foreach (var br in ViewBag.Branches as List<HRSystem.Models.Branch>)
                                {
                                    <option value="@br.BranchId">@br.BranchName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-gradient rounded-pill px-4">حفظ الجهاز</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Edit Device (Updated with Premium Style) -->
    <div class="modal fade" id="editDeviceModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header bg-warning text-white" style="border-radius: 20px 20px 0 0;">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i> تعديل بيانات جهاز البصمة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="EditDevice" method="post">
                    <input type="hidden" name="DeviceId" id="editDeviceId" />
                    <input type="hidden" name="SerialNumber" id="editSerialNumber" />
                    <input type="hidden" name="IsActive" id="editIsActive" />
                    <input type="hidden" name="LastSyncTime" id="editLastSyncTime" />
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم الجهاز</label>
                            <input name="DeviceName" id="editDeviceName" class="form-control rounded-pill px-3" required />
                        </div>
                        <div class="row">
                            <div class="col-md-7 mb-3">
                                <label class="form-label fw-bold">IP العنوان</label>
                                <input name="Ipaddress" id="editIpaddress" class="form-control rounded-pill px-3" required />
                            </div>
                            <div class="col-md-5 mb-3">
                                <label class="form-label fw-bold">البورت</label>
                                <input name="Port" id="editPort" type="number" class="form-control rounded-pill px-3" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الفرع</label>
                            <select name="BranchId" id="editBranchId" class="form-select rounded-pill px-3" required>
                                <option value="">-- اختر الفرع --</option>
                                @foreach (var br in ViewBag.Branches as List<HRSystem.Models.Branch>)
                                {
                                    <option value="@br.BranchId">@br.BranchName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-warning text-white rounded-pill px-4">تحديث الجهاز</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Add User (Updated with Premium Style) -->
    <div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header bg-success text-white" style="border-radius: 20px 20px 0 0;">
                    <h5 class="modal-title fw-bold"><i class="fas fa-user-plus me-2"></i> إرسال موظف للجهاز</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="addUserForm">
                    <input type="hidden" id="targetDeviceId" />
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">كود الموظف (PIN)</label>
                            <input type="text" id="userCode" class="form-control rounded-pill px-3" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الاسم</label>
                            <input type="text" id="userName" class="form-control rounded-pill px-3" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4">إرسال الآن</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal: Excel Bulk Import (Modern Glassmorphic Style) -->
    <div class="modal fade" id="excelImportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="modal-header bg-success text-white py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-white bg-opacity-25 p-2 rounded-circle">
                            <i class="fas fa-file-excel fa-lg text-white"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">استيراد موظفين من Excel وإرسالهم لأجهزة البصمة</h5>
                            <span class="small opacity-75">إضافة وتحديث جماعي لكود واسم الموظف عبر شيت إكسيل</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="excelImportForm" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                        <!-- Template Download Alert -->
                        <div class="alert alert-primary bg-primary-subtle border-primary-subtle d-flex align-items-center justify-content-between p-3 rounded-4 mb-4 flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fas fa-info-circle fa-2x text-primary"></i>
                                <div>
                                    <h6 class="fw-bold text-primary mb-1">تحميل نموذج الإكسيل الاسترشادي</h6>
                                    <p class="text-muted small mb-0">قم بتحميل القالب الجاهز واملأ عمودي كود الموظف والاسم ثم ارفعه هنا مباشرة.</p>
                                </div>
                            </div>
                            <a asp-action="DownloadEmployeeImportTemplate" class="btn btn-primary rounded-pill px-3 shadow-sm text-nowrap">
                                <i class="fas fa-download me-1"></i> تحميل القالب
                            </a>
                        </div>

                        <!-- Target Selector: Single Device Info (When opened from device row) -->
                        <div id="singleDeviceTargetInfo" class="p-3 bg-light rounded-4 border d-none align-items-center gap-3 mb-4">
                            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
                                <i class="fas fa-microchip fa-lg"></i>
                            </div>
                            <div>
                                <span class="text-muted small d-block">الجهاز المستهدف للإرسال:</span>
                                <h6 class="fw-bold text-dark mb-0" id="selectedDeviceNameText">---</h6>
                            </div>
                        </div>

                        <!-- Target Selector: General Scope Dropdown (When opened from top header) -->
                        <div class="mb-4" id="deviceSelectContainer">
                            <label class="form-label fw-bold text-dark"><i class="fas fa-hdd text-info me-1"></i> تحديد الجهاز المستهدف:</label>
                            <select id="importDeviceId" name="deviceId" class="form-select rounded-pill px-3">
                                <option value="">-- إرسال لجميع أجهزة البصمة النشطة --</option>
                                @foreach (var d in Model)
                                {
                                    <option value="@d.DeviceId" data-device-name="@d.DeviceName" data-ip="@d.Ipaddress">جهاز: @d.DeviceName (@d.Ipaddress) - @(d.Branch?.BranchName ?? "بدون فرع")</option>
                                }
                            </select>
                        </div>

                        <!-- File Upload Zone -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark"><i class="fas fa-file-upload text-success me-1"></i> اختيار ملف الإكسيل (.xlsx / .xls):</label>
                            <input type="file" id="importExcelFileInput" name="excelFile" class="form-control rounded-4 p-3 border-2" accept=".xlsx, .xls" required />
                            <small class="text-muted d-block mt-2">
                                <i class="fas fa-check-circle text-success me-1"></i> يدعم الأعمدة: (كود الموظف / Code / No) و (اسم الموظف / Name / SearchName).
                            </small>
                        </div>

                        <!-- Database Sync Checkbox -->
                        <div class="form-check form-switch p-3 bg-light rounded-4 border">
                            <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="syncWithDb" name="syncWithDb" value="true" checked style="width: 2.5em; height: 1.25em;">
                            <label class="form-check-label fw-bold text-dark" for="syncWithDb">
                                حفظ وتحديث الموظفين في قاعدة بيانات النظام (جدول الموظفين)
                                <div class="text-muted fw-normal small">يضمن مزامنة الاسم مع البصمة وعدم ظهور الموظف كـ "غير مسجل" في التقارير.</div>
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-4 bg-light">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" id="btnSubmitExcelImport" class="btn btn-success rounded-pill px-5 fw-bold shadow-sm">
                            <i class="fas fa-cloud-upload-alt me-1"></i> بدء الاستيراد والإرسال
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function() {
            $('#devicesTable').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/ar.json" },
                "pageLength": 10,
                "responsive": true,
                "order": [[ 0, "asc" ]]
            });
        });

        function pingDevice(id) {
            $("#log-" + id).html('<div class="spinner-border spinner-border-sm text-info"></div>');
            $.post('/Branches/Ping', { id: id }, function(res) {
                if (res.success) {
                    $("#log-" + id).html('<span class="text-success smaller fw-bold"><i class="fas fa-check"></i> ' + res.roundtrip + '</span>');
                    Swal.fire({ icon: 'success', title: 'متصل', text: 'زمن الاستجابة: ' + res.roundtrip, timer: 1500, showConfirmButton: false });
                } else {
                    $("#log-" + id).html('<span class="text-danger smaller fw-bold"><i class="fas fa-times"></i> فشل</span>');
                    Swal.fire({ icon: 'error', title: 'غير متصل', text: 'لا يمكن الوصول للجهاز' });
                }
            });
        }

        function checkPort(id) {
            $("#log-" + id).html('<div class="spinner-border spinner-border-sm text-primary"></div>');
            $.post('/Branches/CheckPort', { id: id }, function(res) {
                if (res.success) {
                    $("#log-" + id).html('<span class="text-success smaller fw-bold"><i class="fas fa-plug"></i> متاح</span>');
                } else {
                    $("#log-" + id).html('<span class="text-danger smaller fw-bold"><i class="fas fa-exclamation-circle"></i> مغلق</span>');
                    Swal.fire({ icon: 'error', title: 'البورت مغلق', text: res.message });
                }
            });
        }

        function syncNow(id, btn) {
            Swal.fire({
                title: 'تحديد خيار المزامنة',
                text: "اختر نوع المزامنة المطلوبة لجهاز البصمة:",
                icon: 'question',
                showCancelButton: true,
                showDenyButton: true,
                confirmButtonColor: '#3085d6',
                denyButtonColor: '#f0ad4e',
                cancelButtonColor: '#d33',
                confirmButtonText: '<i class="fas fa-sync-alt"></i> مزامنة تلقائية',
                denyButtonText: '<i class="fas fa-calendar-alt"></i> مزامنة من تاريخ محدد',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    // المزامنة التلقائية
                    executeSync(id, btn, null);
                } else if (result.isDenied) {
                    // مزامنة من تاريخ محدد
                    Swal.fire({
                        title: 'اختر تاريخ بدء المزامنة',
                        input: 'date',
                        inputLabel: 'سيقوم النظام بسحب كافة البصمات المسجلة من بعد هذا التاريخ:',
                        inputValue: new Date(new Date().setDate(new Date().getDate() - 1)).toISOString().split('T')[0], // الافتراضي أمس
                        showCancelButton: true,
                        confirmButtonText: 'ابدأ المزامنة',
                        cancelButtonText: 'إلغاء',
                        inputValidator: (value) => {
                            if (!value) {
                                return 'يجب اختيار التاريخ!'
                            }
                        }
                    }).then((dateResult) => {
                        if (dateResult.isConfirmed) {
                            executeSync(id, btn, dateResult.value);
                        }
                    });
                }
            });
        }

        function executeSync(id, btn, fromDate) {
            const $btn = $(btn);
            const originalHtml = $btn.html();
            
            // Disable and show spinner
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
            $("#log-" + id).html('<span class="text-warning smaller fw-bold"><i class="fas fa-sync fa-spin"></i> جاري المزامنة...</span>');

            $.post('/Branches/SyncNow', { id: id, fromDate: fromDate }, function(res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'نتيجة المزامنة',
                        text: res.message,
                        confirmButtonText: 'حسناً'
                    });
                    $("#log-" + id).html('<span class="text-success smaller fw-bold"><i class="fas fa-check"></i> اكتمل (' + res.logs + ')</span>');
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'فشل المزامنة',
                        text: res.message,
                        confirmButtonText: 'حسناً'
                    });
                    $("#log-" + id).html('<span class="badge bg-danger text-white">فشل المزامنة</span>');
                }
                
                $btn.prop('disabled', false).html(originalHtml);
            }).fail(function() {
                $btn.prop('disabled', false).html(originalHtml);
                $("#log-" + id).html('<span class="text-danger smaller fw-bold">خطأ في الاتصال</span>');
                Swal.fire('خطأ', 'حدث خطأ غير متوقع أثناء الاتصال بالجهاز', 'error');
            });
        }

        function openAddUser(id) {
            $('#targetDeviceId').val(id);
            $('#addUserModal').modal('show');
        }

        function initEditDevice(btn) {
            const $btn = $(btn);
            $('#editDeviceId').val($btn.data('device-id'));
            $('#editDeviceName').val($btn.data('device-name'));
            $('#editIpaddress').val($btn.data('ipaddress'));
            $('#editPort').val($btn.data('port'));
            $('#editBranchId').val($btn.data('branch-id'));
            $('#editSerialNumber').val($btn.data('serial-number'));
            $('#editIsActive').val($btn.data('is-active'));
            
            const lastSync = $btn.data('last-sync-time');
            $('#editLastSyncTime').val(lastSync ? lastSync : '');
            
            $('#editDeviceModal').modal('show');
        }

        $('#addUserForm').submit(function(e) {
            e.preventDefault();
            Swal.fire({ title: 'جاري الإرسال...', didOpen: () => { Swal.showLoading(); } });
            $.post('/Branches/AddUserToDevice', {
                deviceId: $('#targetDeviceId').val(),
                userCode: $('#userCode').val(),
                userName: $('#userName').val()
            }, function(res) {
                Swal.fire({ icon: res.success ? 'success' : 'error', title: res.success ? 'نجاح' : 'فشل', text: res.message });
                if(res.success) $('#addUserModal').modal('hide');
            });
        });

        function deleteDevice(id) {
            Swal.fire({
                title: 'حذف الجهاز؟',
                text: "لن تتمكن من استعادة بيانات هذا الجهاز!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e74a3b',
                confirmButtonText: 'نعم، احذف',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Branches/DeleteDevice', { id: id }, function(res) {
                        if (res.success) location.reload();
                        else Swal.fire('خطأ', res.message, 'error');
                    });
                }
            });
        }

        function syncDeviceTime(id, btn) {
            const $btn = $(btn);
            const originalHtml = $btn.html();
            
            Swal.fire({
                title: 'جاري قراءة وقت جهاز البصمة...',
                html: 'يرجى الانتظار أثناء الاتصال بالجهاز وقراءة الساعة الحالية.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.get('/Branches/GetDeviceTime', { id: id }, function(timeRes) {
                if (timeRes.success) {
                    let timeInfoHtml = `
                        <div class="text-start p-3 bg-light rounded border mb-3">
                            <p class="mb-2"><strong>📱 اسم الجهاز:</strong> ${timeRes.deviceName}</p>
                            <p class="mb-2"><strong>⏰ الوقت الحالي على جهاز البصمة:</strong> <span class="text-primary fw-bold">${timeRes.deviceTime}</span></p>
                            <p class="mb-2"><strong>🖥️ وقت الخادم الحالي:</strong> <span class="text-success fw-bold">${timeRes.serverTime}</span></p>
                            <p class="mb-0"><strong>📊 الحالة:</strong> <span class="${timeRes.isAccurate ? 'text-success' : 'text-danger'} fw-bold">${timeRes.message}</span></p>
                        </div>
                        <p class="text-muted small">هل ترغب في إعادة تلمس وتحديث ساعة البصمة لتكون طابق الساعة الدقيقة للخادم؟</p>
                    `;

                    Swal.fire({
                        title: 'فحص وتعديل وقت الجهاز',
                        html: timeInfoHtml,
                        icon: timeRes.isAccurate ? 'info' : 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: '<i class="fas fa-sync"></i> اضبط الوقت الآن',
                        cancelButtonText: 'إلغاء'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
                            $("#log-" + id).html('<span class="text-warning smaller fw-bold"><i class="fas fa-clock fa-spin"></i> جاري ضبط الوقت...</span>');
                            
                            $.post('/Branches/SyncDeviceTime', { id: id }, function(res) {
                                if (res.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'تم ضبط الوقت بنجاح',
                                        html: `<p>${res.message.replace(/\n/g, '<br/>')}</p>`,
                                        confirmButtonText: 'ممتاز'
                                    });
                                    $("#log-" + id).html('<span class="text-success smaller fw-bold"><i class="fas fa-check"></i> تم ضبط الوقت</span>');
                                } else {
                                    Swal.fire('فشل', res.message, 'error');
                                    $("#log-" + id).html('<span class="text-danger smaller fw-bold">فشل ضبط الوقت</span>');
                                }
                                $btn.prop('disabled', false).html(originalHtml);
                            }).fail(function() {
                                $btn.prop('disabled', false).html(originalHtml);
                                $("#log-" + id).html('<span class="text-danger smaller fw-bold">خطأ في الاتصال</span>');
                                Swal.fire('خطأ', 'حدث خطأ غير متوقع أثناء الاتصال بالجهاز', 'error');
                            });
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'تعذر الاتصال بالجهاز',
                        text: timeRes.message
                    });
                }
            }).fail(function() {
                Swal.fire('خطأ', 'تعذر قراءة الوقت من جهاز البصمة، تأكد من الاتصال والشبكة.', 'error');
            });
        }

        function openExcelImportModal(deviceId, deviceName, ipAddress) {
            $('#importExcelFileInput').val('');
            if (deviceId) {
                // When opened from a specific device row
                $('#importDeviceId').val(deviceId);
                $('#deviceSelectContainer').addClass('d-none');
                $('#selectedDeviceNameText').text(deviceName + (ipAddress ? ' (' + ipAddress + ')' : ''));
                $('#singleDeviceTargetInfo').removeClass('d-none').addClass('d-flex');
            } else {
                // When opened from the general header button
                $('#importDeviceId').val('');
                $('#deviceSelectContainer').removeClass('d-none');
                $('#singleDeviceTargetInfo').addClass('d-none').removeClass('d-flex');
            }
            $('#excelImportModal').modal('show');
        }

        $('#excelImportForm').submit(function(e) {
            e.preventDefault();
            const fileInput = document.getElementById('importExcelFileInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                Swal.fire('تنبيه', 'يرجى اختيار ملف Excel أولاً', 'warning');
                return;
            }

            const formData = new FormData(this);
            formData.set('syncWithDb', $('#syncWithDb').is(':checked'));

            Swal.fire({
                title: 'جاري استيراد ومزامنة الموظفين...',
                html: `
                    <div class="text-center p-3">
                        <div class="spinner-border text-success mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                        <p class="text-muted mb-0">يتم الآن قراءة ملف الإكسيل والاتصال بأجهزة البصمة ونقل الأسماء والأكواد...</p>
                    </div>
                `,
                allowOutsideClick: false,
                showConfirmButton: false
            });

            $.ajax({
                url: '/Branches/ImportUsersToDevicesFromExcel',
                type: 'POST',
                data: formData,
                contentType: false,
                processData: false,
                success: function(res) {
                    if (res.success) {
                        let logsHtml = '';
                        if (res.logs && res.logs.length > 0) {
                            logsHtml = '<div class="text-start mt-3 p-3 bg-light rounded border small" style="max-height: 180px; overflow-y: auto;">' +
                                res.logs.map(l => `<div class="mb-1">${l}</div>`).join('') +
                                '</div>';
                        }

                        Swal.fire({
                            icon: 'success',
                            title: 'اكتمل الاستيراد بنجاح!',
                            html: `
                                <div class="text-center">
                                    <p class="fw-bold fs-6 text-dark mb-2">${res.message}</p>
                                    <div class="d-flex justify-content-center gap-2 my-3 flex-wrap">
                                        <span class="badge bg-primary p-2 px-3 fs-6 rounded-pill">
                                            <i class="fas fa-users me-1"></i> الموظفين: ${res.totalEmployees || 0}
                                        </span>
                                        <span class="badge bg-success p-2 px-3 fs-6 rounded-pill">
                                            <i class="fas fa-check-circle me-1"></i> الأجهزة المحدثة: ${res.syncedDevices || 0} / ${res.totalTargetDevices || 0}
                                        </span>
                                    </div>
                                    ${logsHtml}
                                </div>
                            `,
                            confirmButtonText: 'ممتاز، حسناً'
                        }).then(() => {
                            $('#excelImportModal').modal('hide');
                            location.reload();
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'فشل الاستيراد',
                            text: res.message,
                            confirmButtonText: 'إغلاق'
                        });
                    }
                },
                error: function(xhr) {
                    Swal.fire('خطأ غير متوقع', 'تعذر إتمام الطلب، تأكد من سلامة ملف الإكسيل واتصال الشبكة.', 'error');
                }
            });
        });
    </script>
}
